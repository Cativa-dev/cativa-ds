{
  "$schema": "https://cativa.digital/schemas/design-tokens-1.0.json",
  "name": "Cativa Design System",
  "version": "1.0.0",
  "description": "Tokens canônicos para embeds nativos da plataforma Cativa.",
  "color": {
    "dark": {
      "bg": "#0a0a0c",
      "surface": "#141416",
      "surface-2": "#1b1b1f",
      "surface-3": "#232328",
      "border": "rgba(255,255,255,0.07)",
      "border-strong": "rgba(255,255,255,0.14)",
      "text": "#f4f4f6",
      "text-2": "#a1a1aa",
      "text-3": "#71717a",
      "primary": "#8b5cf6",
      "primary-strong": "#7c3aed",
      "primary-soft": "rgba(139,92,246,0.14)",
      "on-primary": "#ffffff",
      "success": "#34d399",
      "success-soft": "rgba(52,211,153,0.13)",
      "danger": "#fb7185",
      "danger-soft": "rgba(251,113,133,0.13)",
      "warning": "#fbbf24",
      "warning-soft": "rgba(251,191,36,0.13)",
      "info": "#22d3ee",
      "info-soft": "rgba(34,211,238,0.13)"
    },
    "light": {
      "bg": "#f7f7f8",
      "surface": "#ffffff",
      "surface-2": "#f2f2f4",
      "surface-3": "#e9e9ec",
      "border": "rgba(9,9,11,0.08)",
      "border-strong": "rgba(9,9,11,0.14)",
      "text": "#18181b",
      "text-2": "#52525b",
      "text-3": "#a1a1aa",
      "primary": "#7c3aed",
      "primary-strong": "#6d28d9",
      "primary-soft": "rgba(124,58,237,0.10)",
      "on-primary": "#ffffff",
      "success": "#059669",
      "success-soft": "rgba(5,150,105,0.10)",
      "danger": "#e11d48",
      "danger-soft": "rgba(225,29,72,0.10)",
      "warning": "#d97706",
      "warning-soft": "rgba(217,119,8,0.10)",
      "info": "#0891b2",
      "info-soft": "rgba(8,145,178,0.10)"
    }
  },
  "font": {
    "family": {
      "sans": "'Onest', system-ui, sans-serif",
      "serif": "'Newsreader', Georgia, serif",
      "mono": "'JetBrains Mono', monospace"
    },
    "size": {
      "display": "40px",
      "h1": "30px",
      "h2": "24px",
      "body": "16px",
      "sm": "13px",
      "label": "11px",
      "mono": "13px"
    },
    "weight": {
      "regular": 400,
      "medium": 500,
      "semibold": 600,
      "bold": 700,
      "extrabold": 800
    },
    "tracking": {
      "label": "0.08em",
      "tight": "-0.02em"
    }
  },
  "space": {
    "2xs": "4px",
    "xs": "8px",
    "sm": "12px",
    "md": "16px",
    "lg": "24px",
    "xl": "32px",
    "2xl": "48px",
    "3xl": "64px"
  },
  "radius": {
    "sm": "8px",
    "md": "10px",
    "lg": "14px",
    "xl": "20px",
    "pill": "999px"
  },
  "shadow": {
    "dark": {
      "raised": "0 4px 16px rgba(0,0,0,0.28)",
      "overlay": "0 18px 50px rgba(0,0,0,0.45)",
      "glow": "0 10px 40px -8px var(--cds-primary)"
    },
    "light": {
      "raised": "0 4px 16px rgba(9,9,11,0.08)",
      "overlay": "0 18px 50px rgba(9,9,11,0.16)",
      "glow": "0 10px 40px -8px var(--cds-primary)"
    }
  },
  "icon": {
    "library": "lucide",
    "style": "line",
    "stroke": "1.5px",
    "sizes": [
      16,
      18,
      20,
      24
    ]
  }
}