  "font": {
    "family": {
      "sans": "'Onest', system-ui, -apple-system, sans-serif",
      "serif": "'Newsreader', Georgia, serif",
      "mono": "'JetBrains Mono', ui-monospace, monospace"
    },
    "size": {
      "display": "2.5rem",
      "h1": "1.875rem",
      "h2": "1.5rem",
      "h3": "1.25rem",
      "body": "1rem",
      "ui": "0.875rem",
      "sm": "0.8125rem",
      "xs": "0.75rem",
      "label": "0.6875rem",
      "mono": "0.8125rem"
    },
    "weight": {
      "regular": 400,
      "medium": 500,
      "semibold": 600,
      "bold": 700,
      "extrabold": 800
    },
    "lineHeight": {
      "display": 1.02,
      "heading": 1.2,
      "body": 1.6,
      "ui": 1.4,
      "tight": 1
    },
    "tracking": {
      "tight": "-0.02em",
      "snug": "-0.01em",
      "label": "0.08em",
      "caps": "0.06em",
      "wide": "0.14em"
