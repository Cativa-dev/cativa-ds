  },
  "space": {
    "base": "0.25rem",
    "2xs": "0.25rem",
    "xs": "0.5rem",
    "sm": "0.75rem",
    "md": "1rem",
    "lg": "1.5rem",
    "xl": "2rem",
    "2xl": "3rem",
    "3xl": "4rem"
  },
  "radius": {
    "sm": "0.5rem",
    "md": "0.625rem",
    "lg": "0.875rem",
    "xl": "1.25rem",
    "pill": "62.5rem",
    "full": "50%"
  },
  "zIndex": {
    "base": 0,
    "sticky": 20,
    "overlay": 100,
    "toast": 110
  },
  "motion": {
    "durationFast": "0.15s",
    "durationBase": "0.25s",
    "durationSlow": "0.3s",
    "ease": "cubic-bezier(0.2,0.8,0.2,1)",
    "easeOut": "ease-out"
  },
  "layout": {
    "sidebarWidth": "16.5rem",
    "contentMax": "70rem",
    "touchMin": "2.75rem"
  },
  "icon": {
    "library": "lucide",
    "style": "line",
    "strokeWidth": "1.5",
    "sizes": [
      "0.75rem",
      "1rem",
      "1.0625rem",
      "1.125rem",
      "1.375rem"
    ]
  }
