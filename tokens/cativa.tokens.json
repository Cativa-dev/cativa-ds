      "glow-btn": "0 0.375rem 1.25rem -0.375rem var(--cds-primary)"
    },
    "light": {
      "raised": "0 0.25rem 1rem rgba(9,9,11,0.08)",
      "overlay": "0 1.125rem 3.125rem rgba(9,9,11,0.16)",
      "modal": "0 1.5rem 4.375rem rgba(9,9,11,0.20)",
